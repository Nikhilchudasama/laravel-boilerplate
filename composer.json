{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.1.1",
        "inertiajs/inertia-laravel": "^3.1",
        "lab404/laravel-impersonate": "^1.7.8",
        "laravel/framework": "^13.9",
        "laravel/pulse": "^1.7.3",
        "laravel/tinker": "^3.0.2",
        "maatwebsite/excel": "^3.1.69",
        "opcodesio/log-viewer": "^3.24.0",
        "pragmarx/google2fa-laravel": "^3.0.1",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-backup": "^10.2.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.22.1",
        "spatie/laravel-permission": "^7.4.1",
        "spatie/laravel-query-builder": "^7.3",
        "tightenco/ziggy": "^2.6.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.9.6",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29.1",
        "laravel/sail": "^1.59",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "rector/rector": "^2.4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates -u"
        ],
        "lint": [
            "vendor/bin/rector",
            "vendor/bin/pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "@php -d memory_limit=2G vendor/bin/pest --type-coverage --min=70",
        "test:lint": [
            "vendor/bin/pint --parallel --test",
            "vendor/bin/rector --dry-run",
            "npm run test:lint"
        ],
        "test:unit": "vendor/bin/pest --parallel",
        "test:types": [
            "vendor/bin/phpstan analyse --memory-limit=2G",
            "npm run test:types"
        ],
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
